# SztuCode 环境配置模板
# 用法：cp .env.example .env，然后按需修改

# ── Core Daemon ───────────────────────────────────────────────
SZTU_HOST=127.0.0.1
SZTU_PORT=7437

# ── Logging ───────────────────────────────────────────────────
SZTU_LOG_LEVEL=INFO
# 留空则仅输出 stderr，不写文件
SZTU_LOG_FILE=~/.sztu/logs/core.log
# text（人工可读键值对）或 json（结构化，适合日志聚合）
SZTU_LOG_FORMAT=text

# ── Config File ───────────────────────────────────────────────
# SZTU_CONFIG=~/.sztu/config.toml

# ── LLM Provider ──────────────────────────────────────────────
# 选择 LLM 后端：anthropic（默认）或 openai（兼容 DeepSeek 等）
# SZTU_LLM_PROVIDER=anthropic

# ── Anthropic 配置 ────────────────────────────────────────────
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# SZTU_LLM_DEFAULT_MODEL=claude-sonnet-4-6

# ── OpenAI / DeepSeek 配置 ────────────────────────────────────
# SZTU_LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.deepseek.com
# SZTU_LLM_DEFAULT_MODEL=deepseek-chat

# ── Agent ─────────────────────────────────────────────────────
# SZTU_MAX_STEPS=20
