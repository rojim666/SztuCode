# SztuCode TypeScript runtime configuration
# Copy to .env. Existing system environment variables take precedence.

SZTU_HOST=127.0.0.1
SZTU_PORT=7438
# SZTU_DATA_DIR=C:/path/to/sztu-data

# Anthropic
# SZTU_LLM_PROVIDER=anthropic
# SZTU_LLM_DEFAULT_MODEL=<your-provider-model-id>
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_BASE_URL=https://api.anthropic.com/v1

# OpenAI-compatible
# SZTU_LLM_PROVIDER=openai
# SZTU_LLM_DEFAULT_MODEL=<your-provider-model-id>
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.example.com/v1

# Keyless OpenAI-compatible endpoint (for example opencode Zen)
# SZTU_LLM_PROVIDER=openai
# SZTU_LLM_DEFAULT_MODEL=mimo-v2.5-free
# OPENAI_BASE_URL=https://opencode.ai/zen/v1
# SZTU_LLM_KEYLESS=true

# Runtime behavior
# SZTU_LLM_CONTEXT_WINDOW=128000
# SZTU_MAX_STEPS=100
# SZTU_COMPACT_THRESHOLD=0.70
# SZTU_SLIDING_WINDOW_SIZE=5
# SZTU_COMPACT_COOLDOWN=3
# SZTU_COMPACT_CIRCUIT_BREAKER=3
# SZTU_COMPACT_MIN_OLD_TOKENS=2000
# SZTU_PERMISSION_MODE=normal
# SZTU_TRACE_ENABLED=true
# SZTU_TRACE_FILE=C:/path/to/runtime-ts.jsonl
# SZTU_TRACE_INCLUDE_LLM_PAYLOAD=true

# Optional integrations
# SZTU_MCP_CONFIG=C:/path/to/mcp.json
# SZTU_CCSWITCH_DB=C:/path/to/cc-switch.db
